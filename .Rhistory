knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(kableExtra)
maled <- read.csv("https://raw.githubusercontent.com/blopman/epi569/master/maled2023.csv")
#View(maled2023)
yr1bysex <- maled %>%
filter(age<=365 & female==0) %>%
summarize(cases=sum(incidentdiarrhea),
persontime=n(),
incidence = sum(incidentdiarrhea)/n()*365.25)
View(yr1bysex)
print(yr1bysex$incidence)
yr1female <- maled %>%
filter(age<=365 & female==1) %>%
summarize(cases=sum(incidentdiarrhea),
persontime=n(),
incidence = sum(incidentdiarrhea)/n()*365.25)
print(yr1female$incidence)
yr2both <- maled %>%
filter(age > 365 & age < 732) %>%
summarize(cases=sum(incidentdiarrhea),
persontime = n(),
incidence = sum(incidentdiarrhea)/n()*365.25)
print(yr2both)
print(yr2both$incidence)
longprev <- maled %>%
summarize(longprevalence = sum(diarrhea)/n())
View(longprev)
longprev
View(longprev)
longprev$longprevalence
print(longprev$longprevalence)
yr1bysex <- maled %>%
filter(age<=365 & female==0) %>%
summarize(cases=sum(incidentdiarrhea),
persontime=n(),
incidence = sum(incidentdiarrhea)/(n()*365.25))
print(yr1bysex$incidence)
yr1bysex <- maled %>%
filter(age<=365 & female==0) %>%
summarize(cases=sum(incidentdiarrhea),
persontime=n(),
incidence = sum(incidentdiarrhea)/n()*365.25)
print(yr1bysex$incidence)
yr1female <- maled %>%
filter(age<=365 & female==1) %>%
summarize(cases=sum(incidentdiarrhea),
persontime=n(),
incidence = sum(incidentdiarrhea)/n()*365.25)
print(yr1female$incidence)
yr2both <- maled %>%
filter(age > 365 & age < 732) %>%
summarize(cases=sum(incidentdiarrhea),
persontime = n(),
incidence = sum(incidentdiarrhea)/n()*365.25)
print(yr2both$incidence)
longprev <- maled %>%
summarize(longprevalence = sum(diarrhea)/n())
print(longprev$longprevalence)
longprev_2ndweek <- maled %>%
filter(age > 182 & age < 190) %>%
summarize(longprevalence = sum(diarrhea)/n())
print(longprev_2ndweek$longprevalence)
longprev_1stweek <- maled %>%
filter(age > 364 & age < 372) %>%
summarize(longprevalence = sum(diarrhea)/n())
print(longprev_1stweek$longprevalence)
periodprev <- maled %>%
group_by(pid) %>%
summarize(dayswithdiarrhea = sum(diarrhea)) %>%
mutate(diarrheainperiod = ifelse(dayswithdiarrhea > 0, 1,0)) %>%
summarize(prevalence = sum(diarrheainperiod)/n())
periodprev <- maled %>%
group_by(pid) %>%
summarize(dayswithdiarrhea = sum(diarrhea)) %>%
mutate(diarrheainperiod = ifelse(dayswithdiarrhea > 0, 1,0)) %>%
summarize(prevalence = sum(diarrheainperiod)/n())
print(periodprev$prevalence)
View(periodprev)
periodprev_1stweek <- maled %>%
filter(age > 182 & age < 190) %>%
group_by(pid) %>%
summarize(dayswithdiarrhea = sum(diarrhea)) %>%
mutate(diarrheainperiod = ifelse(dayswithdiarrhea > 0, 1,0)) %>%
summarize(prevalence = sum(diarrheainperiod)/n())
print(periodprev_1stweek$prevalence)
periodprev_1st2weeks <- maled %>%
filter(age > 182 & age < 197) %>%
group_by(pid) %>%
summarize(dayswithdiarrhea = sum(diarrhea)) %>%
mutate(diarrheainperiod = ifelse(dayswithdiarrhea > 0, 1,0)) %>%
summarize(prevalence = sum(diarrheainperiod)/n())
print(periodprev_1st2weeks$prevalence)
a <- maled %>%
group_by(pid) %>%
summarize(logpersontime = log(n()),
totalepisodes = sum(incidentdiarrhea),
longprevalence = sum(diarrhea)/n()) %>%
mutate(anydiarrhea = ifelse(totalepisodes >=1,1,0))
b <- maled %>%
group_by(pid) %>%
slice(1)  #%>%
#  select(pid, Country_ID, female, laz)
wide <- left_join(b,a)
View(wide)
m1 <- glm(totalepisodes ~ female + as.factor(Country_ID), family = poisson(link="log"), data = wide, offset = logpersontime)
summary(m1)
irr <- as.data.frame(cbind(exp(coef(m1)),exp(confint(m1))))
print(irr)
View(irr)
m2 <- glm(anydiarrhea ~ female + as.factor(Country_ID), family = binomial (link=logit), data = wide)
summary(m2)
or <- as.data.frame(cbind(exp(coef(m2)),exp(confint(m2))))
View(or)
m3 <- glm(anydiarrhea ~ female + as.factor(Country_ID), family = poisson(link="log"), data = wide)
summary(m3)
library(lmtest)
library(sandwich)
robust <-coeftest(m3, vcov = vcovHC(m3, type="HC1")) #calculate robust variance
pr <- as.data.frame(cbind(exp(coef(robust)),exp(confint(robust))))
View(pr)
