library(lsoda)
transmission_pairs_2025 <- readRDS("~/Documents/Emory/EPI 569/transmission_pairs_2025.rds")
roster_2025 <- readRDS("~/Documents/Emory/EPI 569/roster_2025.rds")
rff_2025 <- readRDS("~/Documents/Emory/EPI 569/rff_2025.rds")
library(lsoda)
parms_1 <- c(alpha = 0.048,
beta = 0.56,
sigma = 0.023,
mu = 0.0,
omega = 0.0)
init_1 <- c(S=115,
I=1,
R=0)
sir_ode_1 <- function(times,init_1,parms_1){
with(as.list(c(parms_1,init_1)), {
dS <- mu*(S+I+R) + omega*R -alpha*beta*I*S/(S+I+R) - mu*S
dI <- alpha*beta*I*S/(S+I+R)-sigma*I - mu*I
dR <- sigma*I  - omega*R - mu*R
list(c(dS,dI,dR))
})
}
times_1 <- seq(0,100,length.out=100)
sir_out_1 <- lsoda(init_1,times_1,sir_ode_1,parms_1)
