parms_2 <- c(alpha = 1.152,
beta = 0.56,
sigma = 0.552,
mu = 0.0,
omega = 0.0,
p_2 = 0.10,
chi = 0.50)
init_2 <- c(S=115,
I=1,
R=0)
vaccine_start_2 <- 7   # day vaccination begins
sir_ode_2 <- function(times, init_2, parms_2){
with(as.list(c(parms_2, init_2)), {
# turn on p_2 only after vaccine_start
p2_t_2 <- ifelse(times >= vaccine_start_2, p_2, 0)
N <- S + I + R + V
dS <- omega*R - alpha*beta*(I/N)*S - mu*S - p2_t*chi*S + (1-p_1*chi)*mu*N
dI <- alpha*beta*(I/N)*S - sigma*I - mu*I
dR <- sigma*I - omega*R - mu*R
dV <- -mu*V + p_1*chi*mu*N + p2_t*chi*S
list(c(dS, dI, dR, dV))
})
}
times_2 <- seq(0,100,length.out=100)
sir_out_2 <- lsoda(init_2,times_2,sir_ode_2,parms_2)
sir_out_long_2 <- melt(as.data.frame(sir_out_2),"time")
times_2 <- seq(0,100,length.out=100)
sir_out_2 <- lsoda(init_2,times_2,sir_ode_2,parms_2)
sir_out_long_2 <- melt(as.data.frame(sir_out_2),"time")
