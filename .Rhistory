R = 0,
V = 0)
sir_ode_4 <- function(times_4,init_4,parms_4){
with(as.list(c(parms_4,init_4)), {
# ODEs
N <- S+I+R+V
dS <- omega*R - alpha*beta*(I/N)*S - mu*S - p_2*chi*S + (1-p_1*chi)*mu*N
dI <- alpha*beta*(I/N)*S - sigma*I - mu*I
dR <- sigma*I  - omega*R - mu*R
dV <- - mu*V + p_1*chi*mu*N + p_2*chi*S
list(c(dS,dI,dR,dV))
})
}
# This creates the output from model equations.
#If you want to run the model for longer, change the second term eg: seq(0,200,...)
times_4 <- seq(0,100,length.out=100)
sir_out_4 <- lsoda(init_4,times_4,sir_ode_4,parms_4)
sir_out_long_4 <- melt(as.data.frame(sir_out_4),"time")
times_4 <- seq(0,100,length.out=100)
sir_out_4 <- lsoda(init_4,times_4,sir_ode_4,parms_4)
sir_out_long_4 <- melt(as.data.frame(sir_out_4),"time")
sir_out_long_4 %>%
filter(variable == "I") %>%
summarise(total_cases = (parms_4['sigma'])*(sum(value))) -> final_size_4
ggplot(sir_out_long_4, aes(x = time, y = value, colour = variable)) +
geom_line(size = 1.2) +
xlab("Time") +
ylab("Number")
View(final_size_4)
View(sir_out_4)
ggplot(sir_out_long_2, aes(x = time, y = value, colour = variable)) +
geom_line(size = 1.2) +
xlab("Time") +
ylab("Number")
ggplot(sir_out_long_3, aes(x = time, y = value, colour = variable)) +
geom_line(size = 1.2) +
xlab("Time") +
ylab("Number")
ggplot(sir_out_long_4, aes(x = time, y = value, colour = variable)) +
geom_line(size = 1.2) +
xlab("Time") +
ylab("Number")
View(final_size_1)
View(final_size_4)
View(sir_out_4)
View(sir_out_2)
View(sir_out_3)
View(sir_out_1)
